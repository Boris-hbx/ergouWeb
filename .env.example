# Next - Focus on the Right Thing
# 本文件是 .env 的占位 / 文档版本,真实密钥 / 密码绝不入 git。
# 生产部署用 `fly secrets set KEY=VALUE -a next-boris` 配置。

# ============ 必须 ============

# Claude API key(Anthropic);本地开发用你自己的;Fly 上用 fly secrets set
ANTHROPIC_API_KEY=sk-ant-...

# ============ 可选 ============

# 数据库文件路径(默认 data/next.db;Fly 上挂 Volume 后通常是 /data/next.db)
# DATABASE_PATH=data/next.db

# 前端静态文件目录(默认 frontend;Docker 镜像里是 /app/frontend)
# FRONTEND_DIR=frontend

# 服务监听端口(默认 8080)
# PORT=8080

# 时区(影响后端按日期分组的查询 / 提醒触发时间格式化)
# TZ=Asia/Shanghai

# ============ Owner Recovery (T-096 / ADR-006) ============
#
# Owner 紧急密码重置的密钥(256-bit 熵 / 64-hex)。
# 未配置时 POST /api/auth/owner-recovery 返回 503(端点降级)。
# 生成命令:openssl rand -hex 32
# 部署:fly secrets set OWNER_RECOVERY_KEY=<生成结果> -a next-boris
# 同时在密码管理器存一份(主 + 应急 = 双备份)。
# 详见 ergouPM/decisions/006-password-recovery.md
OWNER_RECOVERY_KEY=<run: openssl rand -hex 32>
